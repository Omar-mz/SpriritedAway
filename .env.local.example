# ===========================================
# EduBoard LMS - Environment Configuration
# ===========================================
# Copy this file to .env.local and update with your values
# Never commit .env.local to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
# Local: mongodb://localhost:27017/eduboard
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/eduboard
MONGODB_URI=mongodb://localhost:27017/eduboard

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate strong, unique secrets for production!
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# SMTP settings for email verification and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@eduboard.com

# ===========================================
# FIREBASE CONFIGURATION (Optional)
# ===========================================
# For file storage and hosting
# Get these from Firebase Console > Project Settings
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# ===========================================
# APPLICATION URLS
# ===========================================
# Base URL for your application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Default admin account for initial setup
ADMIN_EMAIL=admin@eduboard.com
ADMIN_PASSWORD=admin123

# ===========================================
# CERTIFICATE CONFIGURATION
# ===========================================
# Secret key for certificate generation and validation
CERTIFICATE_SECRET=your-certificate-secret-key

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Environment mode
NODE_ENV=development

# ===========================================
# OPTIONAL: THIRD-PARTY SERVICES
# ===========================================
# Uncomment and configure as needed

# Google OAuth (for social login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (for social login)
# FACEBOOK_CLIENT_ID=your-facebook-client-id
# FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# SendGrid (alternative email service)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Stripe (for payment processing)
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Cloudinary (for image/video hosting)
# CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit this file to version control
# 2. Use strong, unique secrets for production
# 3. Enable 2FA for all service accounts
# 4. Regularly rotate secrets and passwords
# 5. Use environment-specific configurations
# 6. Monitor for leaked credentials

# ===========================================
# QUICK SETUP GUIDE
# ===========================================
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update MongoDB URI (local or Atlas)
# 3. Configure email SMTP settings
# 4. Generate strong JWT secrets
# 5. Set up Firebase project (optional)
# 6. Run: npm run dev
# 7. Visit: http://localhost:3000